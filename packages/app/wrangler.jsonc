{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "roofing-crm",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ipfs/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roofing-crm",
      "database_id": "0d61e046-b7b2-4aa0-b8c1-beef3c6680ed",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "kv_namespaces": [
    { "binding": "AGENT_STORE", "id": "944c2e5f45ce42309c8a8b748800fd0f", "remote": true }
  ],
  "services": [{ "binding": "DATASET", "service": "travis-oracle-explorer", "remote": true }],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "vars": {
    "AGENT_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AGENT_DAILY_NEURONS": "4500"
  }
}
